{
  "name": "stellarpay-mcp",
  "private": true,
  "version": "0.1.0",
  "description": "Pay-per-call MCP tools settled in USDC on Stellar (x402)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "dev:gateway": "npm run dev -w @stellarpay/gateway",
    "dev:demo": "npm run dev -w @stellarpay/demo-server",
    "dev:web": "npm run dev -w @stellarpay/web",
    "cli": "tsx packages/cli/src/index.ts",
    "smoke:router": "tsx scripts/smoke-router.ts"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
