# docker compose: copy to .env next to docker-compose.yml. Secrets stay out of git.

# Gateway
PUBLIC_URL=http://localhost:4021
WEB_ORIGIN=http://localhost:3000
STELLAR_NETWORK=stellar:testnet
# STELLAR_RPC_URL=  (required for stellar:pubnet)
DATABASE_URL=file:/data/toolport.db
# DATABASE_AUTH_TOKEN=
FACILITATOR_URL=https://channels.openzeppelin.com/x402/testnet
FACILITATOR_API_KEY=
# FACILITATOR_SECRET_KEY=S...
# openssl rand -hex 32
SESSION_SECRET=
# Keep false when sellers can register any upstream: true opens an SSRF into the host network.
ALLOW_PRIVATE_UPSTREAMS=false
# AUTH_DISABLED=true   # dev only

# Demo server (free upstream priced by the gateway; set PAY_TO plus a facilitator to charge directly)
# PAY_TO=G...

# Web (build args)
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4021
NEXT_PUBLIC_STELLAR_NETWORK=stellar:testnet
# NEXT_PUBLIC_STELLAR_RPC_URL=
# NEXT_PUBLIC_DOCS_URL=
# NEXT_PUBLIC_REPO_URL=
# NEXT_PUBLIC_CLI_PATH=
# NEXT_PUBLIC_CLI_NPM=
