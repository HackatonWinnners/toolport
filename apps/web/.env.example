# Build-time values: Next inlines NEXT_PUBLIC_* into the bundle, so rebuild after changing them.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4021
NEXT_PUBLIC_STELLAR_NETWORK=stellar:testnet
# NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Header "Docs" link and footer "GitHub" link; hidden when unset.
# NEXT_PUBLIC_DOCS_URL=
# NEXT_PUBLIC_REPO_URL=
# The agent config snippet runs `toolport` (after `npm link -w packages/cli`) unless one of these is set:
# NEXT_PUBLIC_CLI_PATH=/absolute/path/to/toolport/packages/cli/bin/stellarpay.js
# NEXT_PUBLIC_CLI_NPM=true   # once `stellarpay` is published to npm
# Local Playwright runs only: lets e2e/ inject a test signer. Never set it for a deployed build.
# NEXT_PUBLIC_E2E_SIGNER=true
