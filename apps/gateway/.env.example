PORT=4021
PUBLIC_URL=http://localhost:4021
STELLAR_NETWORK=stellar:testnet
# STELLAR_RPC_URL=  (required for stellar:pubnet)
DATABASE_URL=file:stellarpay.db
# DATABASE_AUTH_TOKEN=  (Turso)

# Facilitator: pick ONE
# a) OpenZeppelin hosted (key: https://channels.openzeppelin.com/testnet/gen)
FACILITATOR_URL=https://channels.openzeppelin.com/x402/testnet
FACILITATOR_API_KEY=
# b) Rail402 hosted testnet facilitator: free, no API key (https://rail402.dev)
# FACILITATOR_URL=https://testnet.rail402.dev
# c) in-process with our own fee-paying account (testnet XLM only)
# FACILITATOR_SECRET_KEY=S...

# 32+ random chars (openssl rand -hex 32). Unset or weak → random per process, sessions reset on restart.
SESSION_SECRET=
WEB_ORIGIN=http://localhost:3000
# Upstreams on loopback/private networks are refused unless PUBLIC_URL is localhost.
# ALLOW_PRIVATE_UPSTREAMS=true
# AUTH_DISABLED=true   # dev only: "Authorization: Bearer G..." works without a signature
